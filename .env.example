# ===== Phishing Detection API — production configuration =====
# Copy to .env and set values. All variables are optional; defaults shown.

# --- Authentication ---
# Runtime environment. 'development' allows auth-free startup (dev mode);
# 'production' REQUIRES keys and refuses to start without them (fail-fast).
PHISHGUARD_ENV=development
# Comma-separated API keys. Empty => auth disabled (dev mode).
# Env keys always receive the full 'admin' scope. For per-user keys with scopes,
# expiry and IP allowlists use the /keys endpoints instead.
# WARNING: these env keys are server-side only. NEVER set one as the frontend
# VITE_API_KEY (see frontend/.env below) — it is baked into the JS bundle.
PHISHGUARD_API_KEYS=

# --- Frontend (frontend/.env, Vite) ---
# VITE_API_KEY is compiled into the shipped JavaScript, so it MUST be a
# low-privilege registry key with ONLY scan + feedback + reports scopes
# (create it via POST /keys, then set the scopes there). NEVER put an admin
# key or a PHISHGUARD_API_KEYS env key here — anyone who opens the page can
# read it from the bundle. Admin operations (blocklist/webhook/whitelist
# changes) are done with a runtime-entered admin key in the Reports tab,
# which is held in memory only and never stored or bundled.
#   VITE_API_URL=http://localhost:5000   (or /api behind a proxy)
#   VITE_API_KEY=<scan+feedback+reports registry key>

# --- Known-threat database ---
# Optional community feed URL (PhishTank CSV, OpenPhish, or plain-line list).
# Empty => feed disabled; only the admin-curated local blocklist is used.
PHISHGUARD_THREAT_FEED_URL=
# How often the community feed is re-fetched (hours).
PHISHGUARD_THREAT_FEED_REFRESH_HOURS=24

# --- CORS ---
# Comma-separated allowed origins.
PHISHGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payload limits (bytes) ---
PHISHGUARD_MAX_JSON_BYTES=2097152
PHISHGUARD_MAX_HTML_BYTES=2097152

# --- Rate limiting (per IP, sliding window) ---
PHISHGUARD_RATE_MIN=60
PHISHGUARD_RATE_HOUR=600
# Number of trusted reverse-proxy hops. 0 (default) = X-Forwarded-For is IGNORED
# and the TCP peer address is used for rate limiting / IP allowlist (clients
# cannot spoof it). Set 1 when behind nginx/gunicorn/cloud LB so the header is
# honoured via werkzeug ProxyFix only from the trusted proxy.
PHISHGUARD_TRUST_PROXY=0

# --- Webhook ---
# Comma-separated hostname allowlist. Empty => webhook feature disabled.
PHISHGUARD_WEBHOOK_ALLOWLIST=
# HMAC-SHA256 signing secret for webhook payloads.
PHISHGUARD_WEBHOOK_SECRET=
PHISHGUARD_WEBHOOK_TIMEOUT=10
PHISHGUARD_WEBHOOK_RETRIES=3

# --- Inference / scoring ---
# Temperature scaling factor for logits before sigmoid. If data/models/temperature.json
# exists (produced by calibrate.py) it takes precedence over this env value.
PHISHGUARD_TEMPERATURE=2.8
# Number of fold checkpoints to average via mean logits. 1 = single fold (default,
# lowest RAM). 5 = full ensemble (~1.4GB quantized; requires a machine with enough RAM).
PHISHGUARD_ENSEMBLE_FOLDS=1
# Compute per-request feature importance via a backward pass (default 1). Set 0 to
# reduce latency; clients can still request it per-call via {"explain": true}.
PHISHGUARD_COMPUTE_IMPORTANCE=1
# TTL (seconds) for the in-memory DNS/SSL extraction cache. 0 disables it.
PHISHGUARD_EXTRACT_CACHE_TTL=300
# Threads for /predict/batch. 1 = sequential (default). >1 overlaps DNS/SSL I/O;
# model inference stays serialized by the internal lock regardless.
PHISHGUARD_BATCH_WORKERS=1
