# ===== Phishing Detection API — production configuration =====
# Copy to .env and set values. All variables are optional; defaults shown.

# --- Authentication ---
# Comma-separated API keys. Empty => auth disabled (dev mode).
PHISHGUARD_API_KEYS=

# --- CORS ---
# Comma-separated allowed origins.
PHISHGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payload limits (bytes) ---
PHISHGUARD_MAX_JSON_BYTES=2097152
PHISHGUARD_MAX_HTML_BYTES=2097152

# --- Rate limiting (per IP, sliding window) ---
PHISHGUARD_RATE_MIN=60
PHISHGUARD_RATE_HOUR=600

# --- Webhook ---
# Comma-separated hostname allowlist. Empty => webhook feature disabled.
PHISHGUARD_WEBHOOK_ALLOWLIST=
# HMAC-SHA256 signing secret for webhook payloads.
PHISHGUARD_WEBHOOK_SECRET=
PHISHGUARD_WEBHOOK_TIMEOUT=10
PHISHGUARD_WEBHOOK_RETRIES=3
